{
  "name": "sapling-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build --force && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:services": "node scripts/test-services.mjs",
    "test:performance": "node scripts/lighthouse.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e && npm run test:services",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/react": "7.1.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "pagefind": "1.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
