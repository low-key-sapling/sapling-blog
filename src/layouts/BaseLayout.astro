---
import '@/styles/global.css';
import Icon from '@/components/Icon.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import { site } from '@/config/site';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  article?: { published: Date; updated?: Date };
}
const {
  title,
  description = site.description,
  image = site.socialImage,
  noindex = false,
  article,
} = Astro.props;
const fullTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · 记录技术的生长`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const active = (href: string) =>
  href === '/'
    ? Astro.url.pathname === '/'
    : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html
  lang="zh-CN"
  style={`--accent-light:${site.theme.light};--accent-dark:${site.theme.dark}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f2" />
    <meta name="author" content={site.author.name} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href="/rss.xml"
    />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
        {article.updated && (
          <meta
            property="article:modified_time"
            content={article.updated.toISOString()}
          />
        )}
      </>
    )}
    <title>{fullTitle}</title>
    <script is:inline>
      (() => {
        let preference;
        try {
          preference = localStorage.getItem('sapling:theme');
        } catch {}
        const dark =
          preference === 'dark' ||
          (preference !== 'light' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳转到主要内容
    </a>
    <header class="site-header" data-pagefind-ignore>
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${site.name}首页`}>
          <span class="brand-mark">
            <Icon name="leaf" size={25} />
          </span>
          <span>
            {site.name}
            <small>{site.englishName} / FIELD NOTES</small>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {site.navigation.map((item) => (
            <a
              href={item.href}
              aria-current={active(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <button class="icon-button" data-open-search aria-label="搜索全站">
            <Icon name="search" />
            <kbd>⌘ K</kbd>
          </button>
          <a
            class="icon-button bookmark-nav"
            href="/bookmarks/"
            aria-label="我的收藏"
          >
            <Icon name="bookmark" />
          </a>
          <button
            class="icon-button"
            id="theme-toggle"
            aria-label="切换明暗主题"
            aria-pressed="false"
          >
            <span class="light-icon">
              <Icon name="moon" />
            </span>
            <span class="dark-icon">
              <Icon name="sun" />
            </span>
          </button>
          <details class="mobile-menu">
            <summary class="icon-button" aria-label="打开导航">
              <Icon name="menu" />
            </summary>
            <nav aria-label="移动端导航">
              {site.navigation.map((item) => (
                <a
                  href={item.href}
                  aria-current={active(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
              <a href="/bookmarks/">我的收藏</a>
              <a href="/friends/">友链</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="container footer-top">
        <div>
          <a class="footer-brand" href="/">
            {site.name}
            <Icon name="leaf" />
          </a>
          <p>慢慢积累，让想法生根。</p>
        </div>
        <div class="footer-links">
          <a href="/archives/">文章归档</a>
          <a href="/series/">专题系列</a>
          <a href="/friends/">友链</a>
          {site.socials.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} {site.name}{' '}
          <span class="sample-note">· 示例站点</span>
        </span>
        <span>
          Built with Astro <span class="dot">/</span> 保持好奇，持续生长
        </span>
      </div>
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-dialog-title">
      <div class="dialog-heading">
        <h2 id="search-dialog-title">寻找一片新叶</h2>
        <button class="icon-button" data-close-search aria-label="关闭搜索">
          ✕
        </button>
      </div>
      <SearchPanel />
    </dialog>
    <div id="toast" class="toast" role="status" hidden></div>
    <script>
      import '@/scripts/site';
    </script>
    {site.analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
      ></script>
    )}
  </body>
</html>
