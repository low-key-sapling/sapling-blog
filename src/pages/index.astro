---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import ArticleCard from '@/components/ArticleCard.astro';
import Icon from '@/components/Icon.astro';
import {
  getArticles,
  articleUrl,
  formatDate,
  readingMinutes,
  taxonomyUrl,
} from '@/lib/content';
const articles = await getArticles();
const featured = articles
  .filter((article) => article.data.featured)
  .slice(0, 2);
const tags = [
  ...new Set(articles.flatMap((article) => article.data.tags)),
].slice(0, 7);
---

<BaseLayout>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow green">A SMALL CORNER OF THE INTERNET</p>
        <h1 id="hero-title">
          记录技术的<em>生长</em>，<br />
          也留一点空间给好奇心。
        </h1>
        <p class="hero-description">
          你好，欢迎来到{site.name}。<br />
          这里有 Web 开发的探索、工程实践的笔记，
          <br />
          以及把小小想法变成现实的过程。
        </p>
        <div class="hero-actions">
          <a class="button" href="/blog/">
            翻开手记 <Icon name="arrow" size={17} />
          </a>
          <a class="text-link" href="/about/">
            关于这个角落 <Icon name="external" size={14} />
          </a>
        </div>
        <p class="hero-note">这是一座生长中的数字花园 · 当前为示例内容</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-orbit"></div>
        <div class="hero-notebook">
          <div class="notebook-top">A COLLECTION OF SMALL IDEAS</div>
          <svg
            viewBox="0 0 180 130"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M84 122C75 78 93 36 131 13c4 48-13 78-48 83M84 110c-32-4-50-24-52-54 30 4 47 21 49 45m1 14 37-79" />
            <path d="M20 126h141" stroke-width=".5" />
          </svg>
          <strong>慢慢，生长。</strong>
          <small>NOTES ON CODE & CURIOSITY / VOL. 01</small>
        </div>
        <span class="hero-label">Ideas take root here. ↗</span>
      </div>
    </section>
    <section class="section">
      <div class="section-heading">
        <div class="section-title">
          <h2>值得慢读</h2>
          <span>SELECTED NOTES</span>
        </div>
        <span class="eyebrow muted">从这两篇开始</span>
      </div>
      <div class="featured-grid">
        {featured.map((article) => (
          <ArticleCard article={article} large />
        ))}
      </div>
    </section>
    <section class="section latest-section">
      <div class="section-heading">
        <div class="section-title">
          <h2>最近的手记</h2>
          <span>FRESH LEAVES</span>
        </div>
        <a class="text-link" href="/blog/">
          全部文章 <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="home-latest">
        <div>
          {articles.slice(0, 5).map((article) => (
            <article class="article-row">
              <time datetime={article.data.published.toISOString()}>
                {formatDate(article.data.published)}
              </time>
              <div>
                <h3>
                  <a href={articleUrl(article)}>{article.data.title}</a>
                </h3>
                <div class="eyebrow">
                  <a href={taxonomyUrl('categories', article.data.category)}>
                    {article.data.category}
                  </a>
                  <span class="dot">·</span>
                  <span>{readingMinutes(article.body)} 分钟阅读</span>
                  <span class="sample-note">示例</span>
                </div>
              </div>
              <Icon name="arrow" size={17} />
            </article>
          ))}
        </div>
        <aside class="aside-note">
          <Icon name="leaf" size={24} />
          <h3>沿着兴趣生长</h3>
          <p>
            把遇见的问题记下来，
            <br />
            把想明白的事情分享出去。
          </p>
          <div class="tag-list">
            {tags.map((tag) => (
              <a class="tag" href={taxonomyUrl('tags', tag)}>
                # {tag}
              </a>
            ))}
          </div>
        </aside>
      </div>
    </section>
    <section class="newsletter">
      <div>
        <h2>不必时常来访，也不会错过。</h2>
        <p>通过 RSS 订阅，把新文章送进你喜欢的阅读器。</p>
      </div>
      <a class="button secondary" href="/rss.xml">
        <Icon name="rss" size={17} /> 订阅手记
      </a>
    </section>
  </div>
</BaseLayout>
