---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
---

<BaseLayout title="关于" description={site.author.bio}>
  <div class="container page-content" data-pagefind-body>
    <span hidden data-pagefind-filter="type" data-pagefind-meta="type">
      关于
    </span>
    <PageHeading
      eyebrow="HELLO, FELLOW EXPLORER"
      title="你好，欢迎来坐坐"
      description="代码之外，我们也可以聊聊好奇心。"
    />
    <div class="about-layout">
      <div class="about-body">
        <h2 data-pagefind-meta="title">关于{site.name}</h2>
        <p>
          我在这里整理技术笔记。有时候是一条 Windows
          命令，有时候是一个网页上的交互。每篇手记都尽量留下关键的几行代码，以及用来验证结果的例子。
        </p>
        <p>
          「青苗」意味着不急着长成大树。每一次认真记录，都是给下一次思考留下一点养分。
        </p>
        <h2>这片花园里有什么</h2>
        <p>
          Web
          工程手记讨论网页怎样构建，设计与体验手记关注页面读起来、用起来是否顺手。日常创造收录小工具和自动化脚本。
        </p>
        <div class="tag-list">
          <span class="tag">Web 开发</span>
          <span class="tag">工程实践</span>
          <span class="tag">设计与体验</span>
          <span class="tag">学习笔记</span>
        </div>
        <h2>订阅与仓库</h2>
        <p>新文章会出现在 RSS 订阅里，博客的项目仓库在 GitHub。</p>
        <div class="project-links">
          {site.socials.map((item) => (
            <a class="button secondary" href={item.href}>
              {item.label}
              <Icon name="external" size={15} />
            </a>
          ))}
        </div>
      </div>
      <aside class="about-card">
        {site.author.avatar ? (
          <img
            class="friend-avatar"
            src={site.author.avatar}
            width="60"
            height="60"
            alt={site.author.name}
          />
        ) : (
          <span class="brand-mark">
            <Icon name="leaf" size={36} />
          </span>
        )}
        <h2>{site.author.name}</h2>
        <p>{site.author.bio}</p>
      </aside>
    </div>
  </div>
</BaseLayout>
